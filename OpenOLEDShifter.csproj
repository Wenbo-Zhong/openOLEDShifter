<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <AssemblyName>OpenOLEDShifter</AssemblyName>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Ubuntu/**/*.cs;Core/**/*.cs;Desktop/**/*.cs;Tests/**/*.cs" />
    <ProjectReference Include="Core/OpenOLEDShifter.Core.csproj" />
    <ProjectReference Include="Desktop/OpenOLEDShifter.Desktop.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.34" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>
</Project>
